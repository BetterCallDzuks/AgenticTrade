# Normalize line endings on commit and checkout.
* text=auto

# Source, scripts and config stay LF on every platform.
*.py       text eol=lf
*.sh       text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.toml     text eol=lf
*.json     text eol=lf
*.md       text eol=lf
Dockerfile text eol=lf

# Windows launchers must keep CRLF.
*.bat      text eol=crlf
*.ps1      text eol=crlf

# Binary assets — never diff or convert.
*.db       binary
*.sqlite   binary
*.png      binary
*.jpg      binary
*.jpeg     binary
*.ico      binary
*.pdf      binary
*.zip      binary
*.log      binary
