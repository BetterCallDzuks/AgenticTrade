=====================================================================

1. OBAVEZNO ZA AI ANALIZU (Research Agent)

=====================================================================

GEMINI_API_KEY=tvoj_gemini_api_kljuc_ovdje
GEMINI_MODEL=gemini-3.8-flash

=====================================================================

2. SOLANA MREŽA I EXECUTION AGENT (Opcionalno dok si u Paper modu)

=====================================================================

Preporuka: besplatni Helius ili Shyft RPC ključ za 5x bržu provjeru holdera

SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_PRIVATE_KEY=
LIVE_TRADING_ENABLED=false
LIVE_TRADING_CONFIRMED=false
MAX_LIVE_TRADE_SOL=0.05

=====================================================================

3. POSTAVKE RIZIKA I PORTFELJA

=====================================================================

INITIAL_PAPER_SOL=10.0
TRADE_SIZE_SOL=0.5
MIN_LIQUIDITY_USD=5000
MIN_VOLUME_H1_USD=2500
MAX_TOP10_HOLDER_PCT=35.0

TP1_PCT=80.0
STOP_LOSS_PCT=-25.0
TRAILING_STOP_PCT=20.0
TRAILING_STOP_PCT_AFTER_TP1=15.0

FAST_INVALIDATION_PCT=-12.0
FAST_INVALIDATION_WINDOW_SEC=90
POSITION_MONITOR_SEC=4

MAX_OPEN_POSITIONS=2
MIN_SECONDS_BETWEEN_ENTRIES=60
STOP_LOSS_COOLDOWN_SEC=180

REJECT_M5_DUMP_PCT=-8.0
MAX_CHASE_H1_PCT=400.0
MIN_LIQ_FDV_RATIO=0.05
MIN_LIQ_FDV_APPLY_FDV=50000

SLIPPAGE_BPS=500
PRIORITY_FEE_SOL=0.0015

=====================================================================

4. v8.0 RISK ENGINE

=====================================================================

BOT_TIMEZONE=Europe/Zagreb
PAPER_SOL_PRICE_USD=185.0

FLOW_EXIT_ENABLED=true
FLOW_EXIT_MIN_SELLS=3
FLOW_EXIT_SELL_RATIO=1.3
WHALE_EXIT_ENABLED=true

MAX_DAILY_STOP_LOSSES=2
MAX_DAILY_DRAWDOWN_PCT=5.0
MAX_DAILY_TRADES=8

ENTRY_CONFIRM_SEC=20
ENTRY_CONFIRM_MAX_DROP_PCT=4.0

PAPER_SLIPPAGE_BPS=50
PAPER_EXIT_SLIPPAGE_BPS=80
PAPER_IMPACT_COEFF=1.0

SIZE_AFTER_LOSS_MULT=0.5
SIZE_AI_ONLY_MULT=0.8
SIZE_HEURISTIC_MULT=0.6
SIZE_DRAWDOWN_MULT=0.75
SIZE_DRAWDOWN_TRIGGER_PCT=1.0
MIN_POSITION_SOL=0.1
MAX_POSITION_SOL=

CLUSTER_COOLDOWN_SEC=300
CLUSTER_OPEN_DD_PCT=8.0
CLUSTER_UNPROVEN_SEC=90

WALLET_QUALITY_WINDOW=5
WALLET_QUALITY_MIN_SAMPLES=3
WALLET_QUALITY_MIN_WIN_RATE=0.4

STALE_PRICE_SEC=15
MOVE_STOP_TO_BREAKEVEN_AFTER_TP1=true
BREAKEVEN_BUFFER_PCT=1.0

=====================================================================

5. v9.0 UPGRADES (Time-Stop, Step-Up Trailing, Telegram)

=====================================================================

TIME_STOP_ENABLED=true
MAX_HOLD_NO_PUMP_SEC=900
TIME_STOP_MIN_PROFIT_PCT=20.0

STEP1_TRIGGER_PCT=30.0
STEP1_FLOOR_PCT=-5.0
STEP2_TRIGGER_PCT=50.0
STEP2_FLOOR_PCT=15.0

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

=====================================================================

6. v10.0 UPGRADES (Security, Strategy, Audit)

=====================================================================

# Optional: require this token for /api/*. Open dashboard once as /?token=VALUE
DASHBOARD_TOKEN=
API_RATE_LIMIT_PER_MIN=240

# balanced | conservative | aggressive
STRATEGY_PROFILE=balanced

# JSONL audit trail for live/blocked execution attempts
AUDIT_LOG_PATH=bot_audit.jsonl
JSON_LOGS=false
ALERT_COOLDOWN_SEC=300
ML_MODEL_PATH=ml_model.json
PRICE_CACHE_ENABLED=true
PRICE_CACHE_TTL_SEC=3.0

=====================================================================

7. v11.0 UPGRADES (Metrics, CORS, Graceful Shutdown)

=====================================================================

# Comma separated browser origins. Empty means "same-origin + localhost only".
# Use * to restore the old permissive behaviour (not recommended when exposed).
ALLOWED_ORIGINS=
CORS_ALLOW_ALL=false

# GET /metrics (Prometheus 0.0.4 text) and GET /ready (dependency checks).
# Both honour DASHBOARD_TOKEN when it is set.

