=====================================================================

1. AI ANALIZA (Research Agent: Gemini ILI lokalni model)

=====================================================================

# Gemini (remote). Leave empty if you only run a local model.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Provider selection. auto = Gemini when GEMINI_API_KEY is set, otherwise a
# local OpenAI-compatible server when LLM_BASE_URL is set, otherwise heuristics.
# Explicit values: auto | gemini | openai | ollama | none
# (aliases local/openai-compatible/llama/llamacpp map to openai)
LLM_PROVIDER=auto

# Any OpenAI-compatible endpoint: Ollama, llama.cpp server, LM Studio, vLLM.
# Ollama example: http://127.0.0.1:11434/v1  (start with `ollama serve`)
# LLM_MODEL is the name the local server advertises, e.g. llama3.1:8b.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SEC=60
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
# If every provider fails, fall back to the heuristic scorer instead of skipping.
LLM_FALLBACK_TO_HEURISTIC=true

=====================================================================

2. SOLANA MREŽA I EXECUTION AGENT (Opcionalno dok si u Paper modu)

=====================================================================

Preporuka: besplatni Helius ili Shyft RPC ključ za 5x bržu provjeru holdera

SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_PRIVATE_KEY=
LIVE_TRADING_ENABLED=false
LIVE_TRADING_CONFIRMED=false
MAX_LIVE_TRADE_SOL=0.05

=====================================================================

3. POSTAVKE RIZIKA I PORTFELJA

=====================================================================

INITIAL_PAPER_SOL=10.0
TRADE_SIZE_SOL=0.5
MIN_LIQUIDITY_USD=5000
MIN_VOLUME_H1_USD=2500
MAX_TOP10_HOLDER_PCT=35.0

# TP1_PCT is the first target. TP1_FRACTION is how much is sold there
# (0.5 = half, 1.0 = the whole position as a single take profit).
TP1_PCT=80.0
TP1_FRACTION=0.5
# Optional hard target for the remaining "moonbag"; 0 disables it.
FINAL_TAKE_PROFIT_PCT=0.0
STOP_LOSS_PCT=-25.0
TRAILING_STOP_PCT=20.0
TRAILING_STOP_PCT_AFTER_TP1=15.0
# The trailing stop arms only after this peak gain.
TRAILING_ARM_GAIN_PCT=30.0

FAST_INVALIDATION_PCT=-12.0
FAST_INVALIDATION_WINDOW_SEC=90
POSITION_MONITOR_SEC=4

MAX_OPEN_POSITIONS=2
MIN_SECONDS_BETWEEN_ENTRIES=60
STOP_LOSS_COOLDOWN_SEC=180

REJECT_M5_DUMP_PCT=-8.0
MAX_CHASE_H1_PCT=400.0
MIN_LIQ_FDV_RATIO=0.05
MIN_LIQ_FDV_APPLY_FDV=50000

SLIPPAGE_BPS=500
PRIORITY_FEE_SOL=0.0015

=====================================================================

4. v8.0 RISK ENGINE

=====================================================================

BOT_TIMEZONE=Europe/Zagreb
PAPER_SOL_PRICE_USD=185.0

FLOW_EXIT_ENABLED=true
FLOW_EXIT_MIN_SELLS=3
FLOW_EXIT_SELL_RATIO=1.3
WHALE_EXIT_ENABLED=true

MAX_DAILY_STOP_LOSSES=2
MAX_DAILY_DRAWDOWN_PCT=5.0
MAX_DAILY_TRADES=8

ENTRY_CONFIRM_SEC=20
ENTRY_CONFIRM_MAX_DROP_PCT=4.0
# Pending entries are persisted to SQLite; on restart, entries older than this
# window are dropped instead of being resumed with a stale signal.
ENTRY_CONFIRM_RECOVERY_MAX_SEC=900

PAPER_SLIPPAGE_BPS=50
PAPER_EXIT_SLIPPAGE_BPS=80
PAPER_IMPACT_COEFF=1.0
# 1.0 = linear impact, 0.5 = square-root (constant-product AMM) curve.
PAPER_IMPACT_EXPONENT=1.0
# Shared CostModel: AMM fee, priority fee and expected failed-tx cost.
# Exits also pay for the pool depth the entry consumed.
PAPER_AMM_FEE_BPS=25
PAPER_PRIORITY_FEE_SOL=0.0015
PAPER_FAILED_TX_PROB=0.02

SIZE_AFTER_LOSS_MULT=0.5
SIZE_AI_ONLY_MULT=0.8
SIZE_HEURISTIC_MULT=0.6
SIZE_DRAWDOWN_MULT=0.75
SIZE_DRAWDOWN_TRIGGER_PCT=1.0
MIN_POSITION_SOL=0.1
MAX_POSITION_SOL=

CLUSTER_COOLDOWN_SEC=300
CLUSTER_OPEN_DD_PCT=8.0
CLUSTER_UNPROVEN_SEC=90

WALLET_QUALITY_WINDOW=5
WALLET_QUALITY_MIN_SAMPLES=3
WALLET_QUALITY_MIN_WIN_RATE=0.4

STALE_PRICE_SEC=15
MOVE_STOP_TO_BREAKEVEN_AFTER_TP1=true
BREAKEVEN_BUFFER_PCT=1.0

=====================================================================

5. v9.0 UPGRADES (Time-Stop, Step-Up Trailing, Telegram)

=====================================================================

TIME_STOP_ENABLED=true
MAX_HOLD_NO_PUMP_SEC=900
TIME_STOP_MIN_PROFIT_PCT=20.0

STEP1_TRIGGER_PCT=30.0
STEP1_FLOOR_PCT=-5.0
STEP2_TRIGGER_PCT=50.0
STEP2_FLOOR_PCT=15.0

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

=====================================================================

6. v10.0 UPGRADES (Security, Strategy, Audit)

=====================================================================

# Optional: require this token for /api/*. Open dashboard once as /?token=VALUE
DASHBOARD_TOKEN=
API_RATE_LIMIT_PER_MIN=240

# Risk profile: balanced | conservative | aggressive | high_risk
# conservative/balanced/aggressive only fill keys you leave empty below.
# high_risk is a high-risk/high-reward mode that OVERRIDES the sizing/exit keys
# below (1.5 SOL/trade, 4 open positions, -45% stop, +250% TP1 on 35% of the
# position, 20% daily drawdown). Entry filters are unchanged. Revert by setting
# balanced here (or delete this line) and restarting.
STRATEGY_PROFILE=balanced

# JSONL audit trail for live/blocked execution attempts
AUDIT_LOG_PATH=bot_audit.jsonl
# Rolling text log (relative paths resolve against the project directory).
LOG_FILE_PATH=bot_history.log
JSON_LOGS=false
ALERT_COOLDOWN_SEC=300
ML_MODEL_PATH=ml_model.json
PRICE_CACHE_ENABLED=true
PRICE_CACHE_TTL_SEC=3.0
# Pump.fun tokens without a DexScreener pair are quoted from the bonding curve.
PUMPFUN_CURVE_ENABLED=true
PUMPFUN_CURVE_CACHE_SEC=5.0
PUMPFUN_CURVE_MISS_CACHE_SEC=60.0

=====================================================================

7. v11.0 UPGRADES (Metrics, CORS, Graceful Shutdown)

=====================================================================

# Comma separated browser origins. Empty means "same-origin + localhost only".
# Use * to restore the old permissive behaviour (not recommended when exposed).
ALLOWED_ORIGINS=
CORS_ALLOW_ALL=false

# GET /metrics (Prometheus 0.0.4 text) and GET /ready (dependency checks).
# Both honour DASHBOARD_TOKEN when it is set.

# Dashboard bind address and port.
# 127.0.0.1 keeps the trading API local (recommended). Binding another
# interface REQUIRES a DASHBOARD_TOKEN or the bot refuses to start.
COMMAND_CENTER_HOST=127.0.0.1
COMMAND_CENTER_PORT=8080

# Only set true when a trusted reverse proxy sets X-Forwarded-For. Without it
# the header is ignored, so clients cannot spoof their IP past the rate limit.
TRUST_PROXY_HEADERS=false

# Escape hatch for container/LAN setups that accept an unauthenticated API.
# Doctor warns and the bot starts; do not enable on a shared network.
ALLOW_INSECURE_DASHBOARD=false

# Portfolio database path (relative to the working directory).
PAPER_DB_PATH=paper_portfolio.db

# Run the pre-flight checks before starting the bot:
#   python -m bettercalltrader.doctor

